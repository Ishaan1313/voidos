# ══════════════════════════════════════════════════════════════════════
#  Void OS — configuration (.env)
# ══════════════════════════════════════════════════════════════════════
#  `.env` sits next to voidos.py. The installer, or Void OS itself on first
#  start, creates it from "first setup/.env.example", which lists every setting.
#  To use one that isn't here, add its line to `.env` without the leading "#".
#  A setting that has no line uses its default.
#
#  Format
#   • One KEY=value per line. A comment may follow a value only if there is a
#     space before the `#`:   VOID_PORT=7777   # like this
#   • Windows paths: unquoted (C:\Users\You\voidos-files), in single quotes, or
#     with forward slashes (C:/Users/You/voidos-files). NOT in double quotes —
#     there "\n" in "C:\Users\You\new" turns into a line break.
#   • Settings are read at startup: restart Void OS after editing
#     (Settings → Restart Void OS, or stop and start it).
#   • Accounts, app tiles, notifications, themes and the default interface are
#     managed in the browser — they need no lines here.
#   • Keep `.env` private and never commit it: it holds your secret key.


# ── Essentials ────────────────────────────────────────────────────────

# Signs login cookies and encrypts saved cloud logins and network-share
# passwords. Created for you on first start. Changing it signs everyone out
# and means cloud accounts / network shares have to be set up again.
VOID_SECRET_KEY=

VOID_PORT=7777
VOID_NAME=Void OS                       # shown in the browser title and top bar
VOID_COOKIE_SECURE=false                # set true when served over HTTPS (also enables HSTS)

# Updates (Settings → Updates, Super User only). Void OS checks the project's
# GitHub releases once a day and tells the Super User when a newer version
# exists; nothing installs until the Super User presses Install. The release
# repository is fixed in the code and can't be changed here.
VOID_UPDATES=on                         # off = no checking and no installing at all
VOID_UPDATE_CHECK=true                  # false = don't check daily (Check now still works)


# ══════════════════════════════════════════════════════════════════════
#  Everything else you can set
#  Each line below shows its default. To change one, remove the leading "# "
#  and edit the value; restart Void OS to apply.
# ══════════════════════════════════════════════════════════════════════


# ── Files ─────────────────────────────────────────────────────────────
# Root of everything the Files tab shows. The installer asks for it. A new install
# that isn't told uses ~/voidos-files and writes it here; an older one without a
# value keeps using your home folder. It holds Shared/, Users/ (everyone's My Files)
# and Drives/ (USB drives and network shares).
#   Linux/Pi:  /media/STORAGE   or  /home/pi
#   Windows:   C:\Users\You\voidos-files
# VOID_FILE_ROOT=

# Where App Store apps (Immich, Vaultwarden...) keep their data. Never
# browsable from the Files tab. Set it to put app data on another drive.
# VOID_APP_DATA_DIR=<VOID_FILE_ROOT>/app-data

# Per-guest cap for their personal folder, in MB. 0 = unlimited.
# VOID_GUEST_QUOTA_MB=0

# Largest single request in MB. Bigger files still upload: they are sent in
# pieces of VOID_UPLOAD_CHUNK_MB (files of 50 MB and up). Keep the piece size
# under VOID_MAX_UPLOAD_MB, and under 100 behind a Cloudflare Quick Tunnel.
# VOID_MAX_UPLOAD_MB=500
# VOID_UPLOAD_CHUNK_MB=8
# VOID_UPLOAD_SESSION_TTL_HOURS=24      # abandoned uploads are cleaned up after this long

# How many copy/move/delete transfers run at once.
# VOID_MAX_PARALLEL_TRANSFERS=2

# ── Fair-use limits ────────────────────────────────────────────────────
# These stop one account (or one visitor) from using up what everyone shares.
# A request that goes over a limit gets a clear "too many ..." message.
#
# Threads that serve requests (Linux/macOS). Every open browser tab, terminal and
# slow download holds one while it lasts. Raise this if many people keep tabs open.
# VOID_THREADS=32
#
# Open browser tabs per account (each keeps a live-update channel open), and in total.
# VOID_MAX_CONTROL_SOCKETS_PER_USER=5
# VOID_MAX_CONTROL_SOCKETS_GLOBAL=16
#
# Downloads and media streams going at once: per signed-in account, per visitor
# address on a public share link, and in total.
# VOID_MAX_DOWNLOADS_PER_USER=6
# VOID_MAX_SHARE_DOWNLOADS_PER_IP=2
# VOID_MAX_DOWNLOADS_GLOBAL=10
#
# Copy/move/delete jobs one account can have waiting or running.
# VOID_MAX_FILE_JOBS_PER_USER=5
#
# Free space to always leave on a drive, in MB: uploads and copies are refused
# before they would fill it up. 0 = no reserve.
# VOID_MIN_FREE_MB=1024
#
# How much Guests can add to the Shared folder in total, in MB (their personal
# folder has its own cap, VOID_GUEST_QUOTA_MB). 0 = no cap.
# VOID_SHARED_QUOTA_MB=0

# Void OS's own temporary-files folder (relative = inside the Void OS folder).
# All temporary files go here, never the OS temp folder. On Windows, add this
# folder to your antivirus exclusions for best speed.
# VOID_TMP_DIR=tmp

# Free-space alerts, as a percentage of the drive used.
# VOID_DISK_WARN_PERCENT=90
# VOID_DISK_CRITICAL_PERCENT=95

# Oldest activity-log entries are trimmed past this many.
# VOID_AUDIT_MAX_ENTRIES=5000

# WebDAV (map Void OS as a network drive). Same port as the web UI; use it
# over HTTPS only.
# VOID_WEBDAV_ENABLED=true


# ── Server ────────────────────────────────────────────────────────────
# Behind a reverse proxy (nginx, Caddy, Traefik...)? Trust its X-Forwarded-*
# headers. Only when Void OS is reachable ONLY through that proxy.
# VOID_TRUST_PROXY_HEADERS=false

# What the Restart button does. respawn: Void OS starts a fresh copy of itself.
# exit: it just exits — for when a service wrapper (systemd, NSSM, Task
# Scheduler) already restarts it. Detected automatically when unset.
# VOID_RESTART_MODE=

# Install new Python packages at startup when requirements.txt changed: auto =
# only inside Void OS's own .venv, always = also into a system Python, never.
# VOID_AUTO_INSTALL_PACKAGES=auto


# ── Sign-in ───────────────────────────────────────────────────────────
# VOID_SESSION_HOURS=24

# Lock an IP out for VOID_LOCKOUT_SECONDS after this many wrong passwords.
# VOID_MAX_ATTEMPTS=5
# VOID_LOCKOUT_SECONDS=60

# Extra sites allowed to call Void OS's API with your login (comma-separated,
# scheme + host). Everything else from another site is blocked.
# VOID_ALLOWED_ORIGINS=https://dash.example.com,https://home.example.com

# Sessions shows a country per sign-in, looked up from the visitor's public IP at
# ip-api.com (plain HTTP). off = no IP is ever sent anywhere.
# VOID_GEOLOCATE=on


# ── Interface ─────────────────────────────────────────────────────────
# Layout for accounts set to "Auto": classic (sidebar) or home (home screen).
# Also changeable in Settings → Appearance.
# VOID_UI_MODE_DEFAULT=classic


# ── Terminal ──────────────────────────────────────────────────────────
# The optional second password is set in Access Control → Terminal password.
# A terminal is a shell as the account Void OS runs as, which can read Void OS's own settings, so only
# the Super User can hand terminal access out. To keep terminals away from Void OS's files altogether,
# run them as a separate low-privilege account (Linux/macOS): create it, allow Void OS's user to run
# commands as it with sudo (`voidos ALL=(voidshell) NOPASSWD: ALL`), and name it here.
# VOID_TERMINAL_USER=
# VOID_TERMINAL_ENABLED=true
# VOID_MAX_TERMINAL_SESSIONS_PER_USER=6
# VOID_MAX_TERMINAL_SESSIONS_GLOBAL=16

# Shell to start (any OS). Default: bash on Linux/macOS; PowerShell 7 if
# installed, otherwise Windows PowerShell, on Windows.
# VOID_SHELL=wsl.exe
# VOID_SHELL="C:\Program Files\Git\bin\bash.exe" --login -i


# ── Remote access: Cloudflare ─────────────────────────────────────────
# Quick Tunnel: needs `cloudflared` installed. Gives a public
# https://xxxx.trycloudflare.com address (Settings → Remote access) and
# restarts itself if it drops.
# VOID_CLOUDFLARE_TUNNEL=false
# CF_RESTART_DELAY=5                    # seconds before restarting a dropped tunnel

# Each app tile can also get its own tunnel.
# VOID_MAX_APP_TUNNELS=6

# Keep a Cloudflare Worker pointed at the current tunnel address (Quick Tunnel
# URLs change on every restart). Needs `wrangler`; the token is for when it
# can't log in interactively (dash.cloudflare.com → My Profile → API Tokens,
# "Workers KV Storage: Edit" only — treat it like a password).
# CF_KV_NAMESPACE=
# CF_WORKER_URL=voidos.your-subdomain.workers.dev
# CLOUDFLARE_API_TOKEN=

# Access Gate (PIN in front of tunneled apps): wrong guesses allowed per 10
# minutes across ALL visitors, on top of the per-visitor lockout.
# VOID_GATE_GLOBAL_MAX_FAILS=30

# Only if a "Proxied" Cloudflare DNS record points straight at this server and
# you want a live copy of Cloudflare's IP list instead of the built-in one.
# VOID_CF_IP_RANGES_URL=


# ── Cloud storage (Dropbox / Google Drive) ────────────────────────────
# Create an app with each provider and paste its ID and secret here; users
# then connect their own accounts in Settings. See README "Cloud storage".
# VOID_DROPBOX_CLIENT_ID=
# VOID_DROPBOX_CLIENT_SECRET=
# VOID_GDRIVE_CLIENT_ID=
# VOID_GDRIVE_CLIENT_SECRET=
# Public address the provider sends people back to, if it differs from the
# address you browse Void OS on (e.g. behind a proxy).
# VOID_CLOUD_REDIRECT_BASE=https://void.example.com


# ── App Store ─────────────────────────────────────────────────────────
# unrestricted: an admin may bind any host folder into an app.
# restricted: only folders inside that app's own data folder.
# VOID_BIND_MOUNT_MODE=unrestricted


# ── Share links (public downloads) ────────────────────────────────────
# VOID_SHARE_MAX_ZIP_FILES=20000        # folder downloads stop after this many files...
# VOID_SHARE_MAX_ZIP_BYTES=10737418240  # ...or this many bytes (10 GiB)
# VOID_SHARE_DL_RATE_LIMIT=10           # downloads per visitor IP per window
# VOID_SHARE_DL_RATE_WINDOW_S=60
# VOID_SHARE_STREAM_STALL_TIMEOUT_S=45  # drop a download that stops moving for this long
# VOID_SHARE_LINK_MAX_FAILS=30          # wrong PIN guesses per link (all visitors) per 10 min before a 5 min pause


# ── Intercom (Bluetooth audio) ────────────────────────────────────────
# VOID_INTERCOM_RATE_LIMIT=10           # call starts per user per window
# VOID_INTERCOM_RATE_WINDOW_S=60
